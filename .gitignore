# Virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# Datasets (don't commit big CSVs — keep them local)
data/raw/*.csv

# Streamlit secrets (API keys NEVER go in code or git)
.streamlit/secrets.toml

# OSRM road-km cache (regenerable from the network)
data/cache/

# IDE
.vscode/
.idea/

# generated exports (user downloads, not source)
exports/

# local demo database (user data stays on the machine)
data/*.db
